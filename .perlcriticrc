# Perl::Critic's profile for the lab's Perl, the same as DBIx-Squirrel's.
# Severity 3 ("harsh") and up, from the core policies, with the policy
# name in each message.
severity = 3
verbose  = 8
theme    = core

# Excluded: magic numbers and unused variables are noise more than help
# here, complexity is judged in review, and every module starts
# `use v5.36`, which ProhibitVersionStrings would reject. With v5.36,
# a sub's parameter list is a signature, but PPI 1.291 reads it as a
# prototype after any `use experimental` line that doesn't name
# signatures, so ProhibitSubroutinePrototypes goes too. PPI reads v5.36's
# `isa` operator as a call to UNIVERSAL::isa, the idiom the operator
# replaces, so ProhibitUniversalIsa goes as well. Perl::Critic keeps
# only the last `exclude` line, so they all go on one.
exclude  = ValuesAndExpressions::ProhibitMagicNumbers Variables::ProhibitUnusedVariables Subroutines::ProhibitExcessComplexity ValuesAndExpressions::ProhibitVersionStrings Subroutines::ProhibitSubroutinePrototypes BuiltinFunctions::ProhibitUniversalIsa

# Tests have no shebang line, so without this Perl::Critic takes them for
# modules, wanting a package and a closing `1;`.
program-extensions = .pl .t

# Setting @ISA directly is the plain way to subclass the DBI's classes,
# which DBI.pm has already loaded. Down from 3, so it's reported only
# when running at severity 2 or below.
[ClassHierarchies::ProhibitExplicitISA]
severity = 2

# The DBI's API names its methods connect and do, so subclasses must too,
# and the statement handle's bind keeps the name DBIx-Squirrel 1 gave it.
[Subroutines::ProhibitBuiltinHomonyms]
allow = bind connect do

# $DBI::errstr and its kin are the DBI's documented interface.
[Variables::ProhibitPackageVars]
add_packages = DBI
